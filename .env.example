# LLM Minecraft agent — local configuration.
# Copy to .env (git-ignored, never commit it) and fill in what you use.
# No key is required: without one the agent runs in demo mode, where the
# deterministic game-graph planner picks every action.

# --- Minecraft server (a 1.18 Java server; see README for the local setup) ---
MC_HOST=127.0.0.1
MC_PORT=61417
MC_USERNAME=bot
MINECRAFT_VERSION=1.18

# --- Agent ---
# Item the bot works toward, e.g. wooden_pickaxe, stone_pickaxe
GOAL=wooden_pickaxe
# Max perceive-plan-act ticks before the agent gives up
MAX_STEPS=60

# --- LLM (optional; one key is enough) ---
# gemini | openai | auto (auto prefers Gemini when its key is set)
LLM_PROVIDER=auto
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=
